# Copy to .env.integration. This profile has its own .dev-data/integration folder.
# Configure TEST model/LLM/portrait credentials in its admin page; never copy prod storage.
# Saved admin configuration takes precedence over these environment defaults.
SEEDANCE_MODE=mock
TIKHUB_API_KEY=
TOS_ENABLED=false
TOS_REGION=cn-beijing
TOS_ENDPOINT=https://tos-cn-beijing.volces.com
TOS_BUCKET=
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
# Only for a dedicated development callback: public HTTPS origin, no path.
PORTRAIT_PUBLIC_BASE_URL=

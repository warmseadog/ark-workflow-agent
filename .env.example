DATABASE_URL=sqlite:///storage/studio.db
APP_HOST=127.0.0.1
APP_PORT=8000
STORAGE_DIR=storage
DEFACE_BIN=deface
DEFACE_REPLACEWITH=mosaic
DEFACE_MOSAIC_SIZE=20
DEFACE_MASK_SCALE=1.4
SEEDANCE_MODE=mock
SEEDANCE_API_URL=
SEEDANCE_API_KEY=
SEEDANCE_POLL_SECONDS=5
MAX_UPLOAD_MB=512

# Optional: use the current browser session for yt-dlp. Example: chrome or edge.
YTDLP_COOKIES_FROM_BROWSER=
# Alternative cookie Netscape file when the worker cannot access the browser profile.
YTDLP_COOKIE_FILE=

# TikHub social video parsing (or save the key in the link settings panel)
TIKHUB_API_KEY=

# Optional TOS; saving in the admin page takes precedence
TOS_ENABLED=false
TOS_REGION=cn-beijing
TOS_ENDPOINT=https://tos-cn-beijing.volces.com
TOS_BUCKET=
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
